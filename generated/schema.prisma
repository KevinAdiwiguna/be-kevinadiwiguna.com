generator client {
  provider     = "prisma-client-js"
  output       = "../generated"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id       BigInt  @id @default(autoincrement())
  email    String  @unique
  password String?
  name     String?

  emailVerified DateTime?
  isDisabled    Boolean   @default(false)

  roleId BigInt?
  role   roles?  @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rate_limits rate_limits[]

  accounts    accounts[]
  activities  activities[]
  blogs       blogs[]
  experiences experiences[]
  userSkills  user_skills[]

  refreshTokens     refresh_tokens[]
  magicLinks        magic_links[]
  verificationCodes verification_codes[]
  userExperiences   user_experiences[]
  files             files[]
}

model roles {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  users       users[]
  permissions roles_permissions[]
}

model accounts {
  id            BigInt    @id @default(autoincrement())
  userId        BigInt
  provider      String
  providerId    String?
  providerEmail String?
  accessToken   String?
  refreshToken  String?
  scope         String?
  tokenType     String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user users @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@index([userId])
}

model activities {
  id         BigInt   @id @default(autoincrement())
  userId     BigInt?
  action     String
  targetType String?
  targetId   BigInt?
  metadata   Json?
  createdAt  DateTime @default(now())

  user users? @relation(fields: [userId], references: [id])
}

model blogs {
  id        BigInt   @id @default(autoincrement())
  title     String
  slug      String   @unique
  content   String
  thumbnail String?
  published Boolean  @default(false)
  authorId  BigInt?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author users?      @relation(fields: [authorId], references: [id])
  techs  blog_tech[]
}

model blog_tech {
  blogId BigInt
  techId BigInt

  blog blogs @relation(fields: [blogId], references: [id])
  tech tech  @relation(fields: [techId], references: [id])

  @@id([blogId, techId])
}

model projects {
  id          BigInt   @id @default(autoincrement())
  name        String
  slug        String   @unique
  repoUrl     String?
  demoUrl     String?
  thumbnail   String?
  description String?
  isFeatured  Boolean  @default(false)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  techs project_tech[]
}

model project_tech {
  projectId BigInt
  techId    BigInt

  project projects @relation(fields: [projectId], references: [id])
  tech    tech     @relation(fields: [techId], references: [id])

  @@id([projectId, techId])
}

model experiences {
  id             BigInt    @id @default(autoincrement())
  companyName    String    @unique
  role           String?
  description    String?
  image          String?
  url            String?
  durationMonths Int?
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  ownerId         BigInt
  owner           users              @relation(fields: [ownerId], references: [id])
  userExperiences user_experiences[]
}

model user_experiences {
  userId       BigInt
  experienceId BigInt

  user       users       @relation(fields: [userId], references: [id])
  experience experiences @relation(fields: [experienceId], references: [id])

  @@id([userId, experienceId])
}

model skills {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  image     String?
  createdAt DateTime @default(now())

  users user_skills[]
}

model user_skills {
  userId    BigInt
  skillId   BigInt
  level     String?
  createdAt DateTime @default(now())

  skill skills @relation(fields: [skillId], references: [id])
  user  users  @relation(fields: [userId], references: [id])

  @@id([userId, skillId])
}

model tech {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique
  url       String?
  image     String?
  createdAt DateTime @default(now())

  blogTech    blog_tech[]
  projectTech project_tech[]
}

model heroes {
  id          BigInt   @id @default(autoincrement())
  title       String
  description String?
  githubLink  String?
  cvLink      String?
  phoneNumber String?
  isPrimary   Boolean  @unique @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model verification_codes {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  code      String
  context   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user users @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([code])
}

model magic_links {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?
  tokenHash String
  email     String
  createdAt DateTime @default(now())
  expiresAt DateTime
  used      Boolean  @default(false)
  returnTo  String?

  user users? @relation(fields: [userId], references: [id])

  @@index([email])
  @@index([tokenHash])
}

model refresh_tokens {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  replacedById BigInt?
  replacedBy   refresh_tokens? @relation("tokenReplacement", fields: [replacedById], references: [id])

  replaces refresh_tokens[] @relation("tokenReplacement")

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model permissions {
  id        BigInt   @id @default(autoincrement())
  name      String   @unique // e.g. "create_blog"
  label     String? // e.g. "Create Blog"
  createdAt DateTime @default(now())

  roles roles_permissions[]
}

model roles_permissions {
  roleId       BigInt
  permissionId BigInt

  role       roles       @relation(fields: [roleId], references: [id])
  permission permissions @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model rate_limits {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?
  ip        String?
  action    String
  count     Int      @default(1)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user users? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([ip])
  @@index([action])
}

model files {
  id        BigInt   @id @default(autoincrement())
  key       String   @unique
  url       String
  mime      String
  size      Int?
  bucket    String   @default("kevinadiwiguna-assets")
  ownerId   BigInt?
  owner     users?   @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
}

